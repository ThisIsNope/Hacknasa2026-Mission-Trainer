[sub_resource type="GDScript" id="GDScript_tbgi4"]
script/source = "class_name ExpansionPoint
extends CSGBox3D

const CHECK_DISTANCE := 50.0
const RAY_OFFSET := 0.5

@export var check_on_ready := false
@onready var hallway_1: CSGBox3D = $\"../../Hallway1\"

var is_open := false


func get_gen() -> Node3D:
	return null


func get_giro() -> float:
	return 0.0


func _ready() -> void:
	if check_on_ready:
		await get_tree().physics_frame
		await get_tree().physics_frame
		check_space()


func check_space() -> void:
	if is_open or not is_inside_tree():
		return
	if has_obstacle():
		get_parent().queue_free()


func interact(_player: Node3D) -> void:
	if is_open:
		return

	if has_obstacle():
		get_parent().queue_free()
		return

	is_open = true

	var gen := get_gen()
	var nueva_caja = hallway_1.duplicate()
	hallway_1.get_parent().add_child(nueva_caja)

	var gns_1: Node3D = nueva_caja.get_node(\"GNS1\")
	gns_1.position = Vector3(nueva_caja.size.x / 2.0, 0, 0)

	var giro := Transform3D(Basis(Vector3.UP, get_giro()), Vector3.ZERO)
	nueva_caja.global_transform = gen.global_transform * giro * gns_1.transform.affine_inverse()

	await get_tree().physics_frame
	await get_tree().physics_frame

	if not is_instance_valid(nueva_caja):
		return
	for n in nueva_caja.find_children(\"*\", \"\", true, false):
		if n is ExpansionPoint:
			n.check_space()


func has_obstacle() -> bool:
	var gen := get_gen()
	var dir = (gen.global_basis * Basis(Vector3.UP, get_giro()) * Vector3(-1, 0, 0)).normalized()
	var from = gen.global_position + dir * RAY_OFFSET
	var to = gen.global_position + dir * CHECK_DISTANCE

	var query = PhysicsRayQueryParameters3D.create(from, to)
	var hit = get_world_3d().direct_space_state.intersect_ray(query)
	return not hit.is_empty()
"

